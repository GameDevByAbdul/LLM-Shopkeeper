<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the Unity EditMode tests outside Unity: compiles the exact same Core + test sources. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion> <!-- Unity's C# version: keeps Core compatible with the engine -->
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NUnit2005;NUnit2007</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Shopkeeper/Core/**/*.cs" />
    <Compile Include="../../Assets/Shopkeeper/Tests/EditMode/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
  </ItemGroup>
</Project>
