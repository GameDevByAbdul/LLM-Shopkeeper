# Copy to proxy/.env (gitignored) and fill in. Real environment variables override this file.

# gemini | mock   (mock runs fully offline, no key needed)
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-api-key-here

LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite
# If the primary hasn't answered after this many seconds, race the fallback model (0 = failover only).
LLM_HEDGE_AFTER_S=2.5
# minimal | low | medium | high | (empty = model default). Minimal keeps latency ~1s.
LLM_THINKING_LEVEL=minimal

PROXY_HOST=127.0.0.1
PROXY_PORT=8787
# Optional shared secret; if set, the client must send X-Proxy-Token. Required to bind off-loopback.
PROXY_CLIENT_TOKEN=
UPSTREAM_TIMEOUT_S=12

# Mock provider only: fraction of responses that are deliberately broken.
MOCK_CHAOS=0.15
